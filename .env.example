# ============================================================
# Atelier — variables de entorno
# Copiá este archivo como `.env.local` y completá los valores.
# Sin las de Supabase, la app corre en MODO DEMO (datos mock, sin auth).
# ============================================================

# --- Supabase (Fase 1) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth ---
# Dominios de Google permitidos, coma-separados (ej: tu-dominio.com,otro.com)
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=
# Emails puntuales aprobados además de los dominios, coma-separados (ej: juan@otra.com)
NEXT_PUBLIC_ALLOWED_EMAILS=

# --- Resend / emails (Fase 4) ---
RESEND_API_KEY=
RESEND_FROM=Atelier <alertas@tu-dominio.com>

# Secreto para proteger POST /api/shopify/sync en producción (header Authorization: Bearer ...).
SYNC_SECRET=

# --- Shopify (Fase 2 · Dev Dashboard / client credentials) ---
SHOPIFY_STORE_DOMAIN=tu-tienda.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_WEBHOOK_SECRET=

# --- Meta Ads (Fase 3) ---
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
