# ============================================================
# Atelier — variables de entorno
# Copiá este archivo como `.env.local` y completá los valores.
# Sin las de Supabase, la app corre en MODO DEMO (datos mock, sin auth).
#
# [PROD] = obligatoria en el deploy de Vercel.
# ============================================================

# --- Supabase [PROD] ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Debe ser la `sb_secret_...` nueva o el JWT legacy cuyo rol sea `service_role`.
# No copiar la anon key: con RLS puede devolver listas vacÃ­as y dejar el stock
# sin sincronizar aunque la variable exista.

# --- Auth ---
# Dominios de Google permitidos, coma-separados (ej: tu-dominio.com,otro.com)
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=
# Emails puntuales aprobados además de los dominios, coma-separados (ej: juan@otra.com)
NEXT_PUBLIC_ALLOWED_EMAILS=
# URL pública y estable de la app. La usan los links de los emails de invitación
# y, sobre todo, la address con la que se registran los webhooks de Shopify.
# Si no está, se cae a VERCEL_PROJECT_PRODUCTION_URL (que Vercel setea sola con
# el dominio de producción). Nunca se deriva de la request: ver publicAppOrigin()
# en src/lib/env.ts. [PROD]
NEXT_PUBLIC_APP_URL=

# OPT-OUT, no opt-in: con Supabase configurado la auth viene PRENDIDA sola.
# Poné "false" —y solo fuera de Vercel— para ver una build local sin loguearte
# (`next build && next start`). Cualquier otro valor, vacía o ausente = prendida.
# En los deploys de Vercel (production y preview) el flag ni se lee: la auth es
# SIEMPRE obligatoria — ver isAuthEnabled() en src/lib/supabase/config.ts.
NEXT_PUBLIC_AUTH_ENABLED=

# --- Resend / emails [PROD] ---
# Sin estas dos, TODOS los emails quedan inertes: invitaciones de usuarios,
# alertas de stock bajo y el resumen diario. El remitente tiene que ser de un
# dominio verificado en Resend.
RESEND_API_KEY=
RESEND_FROM=Atelier <alertas@tu-dominio.com>

# --- Secretos de endpoints internos [PROD] ---
# SYNC_SECRET protege POST /api/shopify/sync y /api/shopify/register-webhooks
# (header `Authorization: Bearer ...` o `x-sync-secret`).
# OBLIGATORIA en Vercel: sin ella esos endpoints devuelven 401 en los deploys.
# En local, si no está, se permite la llamada sin auth.
SYNC_SECRET=

# CRON_SECRET protege el cron del resumen diario (/api/cron/daily-summary).
CRON_SECRET=

# --- Shopify [PROD] ---
SHOPIFY_STORE_DOMAIN=tu-tienda.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Si no se define, la verificación HMAC de los webhooks cae a SHOPIFY_CLIENT_SECRET.
SHOPIFY_WEBHOOK_SECRET=
# Opcional, default 2026-07
SHOPIFY_API_VERSION=

# --- Meta Ads ---
# Token de System User SIN vencimiento y con permiso `ads_read`, generado desde
# el Business Manager dueño de la cuenta publicitaria.
META_ACCESS_TOKEN=

# Clave secreta de la app (App Dashboard → Configuración → Básica).
# Firma cada llamada a la Graph API con `appsecret_proof`, de modo que el token
# de arriba no sirva fuera de nuestro backend. OBLIGATORIA en los deploys: si
# falta, metaGraph() tira error en vez de llamar sin firma.
# Requiere además activar "Require App Secret" en Configuración → Avanzado →
# Seguridad; sin ese toggle, Meta acepta llamadas sin firmar y la protección
# no sirve de nada.
META_APP_SECRET=
# ID de la cuenta publicitaria, con o sin prefijo `act_`.
# SADAELS = 205681188375750 (business Lanzallamas SRL, moneda ARS).
META_AD_ACCOUNT_ID=
# Versión de la Graph API. El default del código es v21.0, que es de oct-2024:
# confirmá la vigente en developers.facebook.com/docs/graph-api/changelog y
# fijala acá explícitamente en vez de depender del default.
META_API_VERSION=

# Nota: META_APP_ID no lo usa el código (el `appsecret_proof` se calcula solo
# con el secret). Guardalo igual en el gestor de contraseñas: hace falta si
# alguna vez se rota el token o se llama a endpoints a nivel app.

# --- Learnings de IA (insights por campaña) ---
# Clave del AI Gateway de Vercel. La usa el agente que genera los insights
# (src/lib/meta/learnings.ts, modelo anthropic/claude-sonnet-5). Sin esta clave
# el panel de Learnings falla en runtime, no en build.
AI_GATEWAY_API_KEY=

# Feature flag de despliegue: el código de Learnings viaja en todos los deploys
# pero el panel y POST /api/meta/learnings quedan apagados (404) hasta que valga
# exactamente "true". Pensado para prenderlo primero en Preview y recién después
# en Production.
LEARNINGS_ENABLED=
